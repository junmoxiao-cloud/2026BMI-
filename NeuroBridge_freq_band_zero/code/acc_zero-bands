"""
Compare Top-1 / Top-5 EEG-to-image retrieval accuracy for sub-08:
  original EEG  vs  each frequency-band-zeroed EEG.

Uses:
  - checkpoint: data/intra-subjects_sub-08_checkpoint_last.pth
  - original:   data/things_eeg/preprocessed_eeg
  - zeroed:     data/things_eeg/preprocessed_eeg_zero_<band>_fourier

Run from repo root:
  conda activate neurobridge
  cd d:\\git\\NeuroBridge
  $env:PYTHONPATH = "."
  python data/acc_zero-bands
"""

from __future__ import annotations

import argparse
import csv
import os
import shutil
import sys

import matplotlib.pyplot as plt
import numpy as np
import torch
from torch.utils.data import DataLoader

# Allow running as: python data/acc_zero-bands
_REPO_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
if _REPO_ROOT not in sys.path:
    sys.path.insert(0, _REPO_ROOT)

from module.dataset import EEGPreImageDataset
from module.eeg_encoder.model import EEGProject
from module.projector import ProjectorLinear
from module.util import retrieve_all

BANDS = [
    "delta",
    "theta",
    "alpha",
    "beta",
    "low_gamma",
    "gamma",
    "high_gamma",
]

DEFAULT_CHANNELS = [
    "P7", "P5", "P3", "P1", "Pz", "P2", "P4", "P6", "P8",
    "PO7", "PO3", "POz", "PO4", "PO8", "O1", "Oz", "O2",
]


def ensure_info_json(eeg_dir: str, info_src: str) -> None:
    """Zero-band folders may lack info.json; copy from original preprocessed_eeg."""
    dst = os.path.join(eeg_dir, "info.json")
    if not os.path.isfile(dst):
        if not os.path.isfile(info_src):
            raise FileNotFoundError(f"Missing info.json source: {info_src}")
        shutil.copy2(info_src, dst)
        print(f"  copied info.json -> {dst}")


def load_model(checkpoint_path: str, latent_dim: int, n_times: int, n_ch: int, feature_dim: int, device):
    model = EEGProject(
        feature_dim=latent_dim,
        eeg_sample_points=n_times,
        channels_num=n_ch,
    ).to(device)
    eeg_projector = ProjectorLinear(latent_dim, feature_dim).to(device)
    img_projector = ProjectorLinear(latent_dim, feature_dim).to(device)

    ckpt = torch.load(checkpoint_path, map_location=device, weights_only=False)
    model.load_state_dict(ckpt["model_state_dict"])
    eeg_projector.load_state_dict(ckpt["eeg_projector_state_dict"])
    img_projector.load_state_dict(ckpt["img_projector_state_dict"])

    model.eval()
    eeg_projector.eval()
    img_projector.eval()
    return model, eeg_projector, img_projector


def set_seed(seed: int) -> None:
    import random

    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)


@torch.no_grad()
def evaluate_eeg_dir(
    eeg_data_dir: str,
    args,
    device: torch.device,
) -> dict[str, float]:
    ensure_info_json(eeg_data_dir, os.path.join(args.eeg_ori_dir, "info.json"))

    # Match official intra-subject eval: average EEG + image_test_aug
    use_img_aug = bool(args.image_test_aug)
    dataset = EEGPreImageDataset(
        subject_ids=args.sub_id,
        eeg_data_dir=eeg_data_dir,
        selected_channels=args.selected_channels,
        time_window=args.time_window,
        image_feature_dir=args.image_feature_dir,
        text_feature_dir=args.text_feature_dir,
        image_aug=use_img_aug,
        aug_image_feature_dirs=args.aug_image_feature_dirs if use_img_aug else [],
        average=True,
        _random=False,
        eeg_transform=None,
        train=False,
        image_test_aug=use_img_aug,
        eeg_test_aug=False,
        frozen_eeg_prior=False,
    )
    loader = DataLoader(dataset, batch_size=args.batch_size, shuffle=False)

    latent_dim = dataset.image_features.shape[-1]
    n_ch = len(args.selected_channels) if args.selected_channels else dataset.channels_num
    n_times = args.time_window[1] - args.time_window[0]

    model, eeg_proj, img_proj = load_model(
        args.checkpoint_path, latent_dim, n_times, n_ch, args.feature_dim, device
    )

    eeg_list, img_list = [], []
    for batch in loader:
        eeg = batch[0].to(device)
        img = batch[1].to(device)
        eeg_feat = eeg_proj(model(eeg))
        img_feat = img_proj(img)
        if args.img_l2norm:
            img_feat = torch.nn.functional.normalize(img_feat, p=2, dim=1)
        if args.eeg_l2norm:
            eeg_feat = torch.nn.functional.normalize(eeg_feat, p=2, dim=1)
        eeg_list.append(eeg_feat.cpu().numpy())
        img_list.append(img_feat.cpu().numpy())

    eeg_all = np.concatenate(eeg_list, axis=0)
    img_all = np.concatenate(img_list, axis=0)
    top5_count, top1_count, total = retrieve_all(eeg_all, img_all, average=True)

    return {
        "top1": top1_count / total * 100.0,
        "top5": top5_count / total * 100.0,
        "n": float(total),
    }


def plot_results(rows: list[dict], out_path: str, sub_id: int) -> None:
    labels = [r["condition"] for r in rows]
    top1 = [r["top1"] for r in rows]
    top5 = [r["top5"] for r in rows]

    x = np.arange(len(labels))
    width = 0.35
    fig, ax = plt.subplots(figsize=(12, 5.5))
    b1 = ax.bar(x - width / 2, top1, width, label="Top-1 Acc (%)", color="#4C72B0")
    b2 = ax.bar(x + width / 2, top5, width, label="Top-5 Acc (%)", color="#55A868")
    ax.set_ylabel("Accuracy (%)")
    ax.set_title(f"sub-{sub_id:02d}: Original vs band-zeroed EEG (EEG-to-image)")
    ax.set_xticks(x)
    ax.set_xticklabels(labels, rotation=20, ha="right")
    ax.legend()
    ax.set_ylim(0, max(max(top1), max(top5)) * 1.25 + 1)

    ori_top1 = top1[0]
    for i, (bar, v) in enumerate(zip(b1, top1)):
        ax.annotate(f"{v:.1f}", xy=(bar.get_x() + bar.get_width() / 2, v),
                    xytext=(0, 3), textcoords="offset points", ha="center", fontsize=8)
        if i > 0:
            ax.annotate(f"Δ{v - ori_top1:+.1f}", xy=(bar.get_x() + bar.get_width() / 2, v),
                        xytext=(0, 14), textcoords="offset points", ha="center", fontsize=7, color="#333333")
    for bar, v in zip(b2, top5):
        ax.annotate(f"{v:.1f}", xy=(bar.get_x() + bar.get_width() / 2, v),
                    xytext=(0, 3), textcoords="offset points", ha="center", fontsize=8)

    fig.tight_layout()
    fig.savefig(out_path, dpi=200, bbox_inches="tight")
    plt.close(fig)
    print(f"Saved figure: {out_path}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description="sub-08 band-zero vs original Top-1/Top-5 accuracy"
    )
    parser.add_argument(
        "--checkpoint_path",
        default=os.path.join(_REPO_ROOT, "data", "intra-subjects_sub-08_checkpoint_last.pth"),
    )
    parser.add_argument(
        "--eeg_ori_dir",
        default=os.path.join(_REPO_ROOT, "data", "things_eeg", "preprocessed_eeg"),
    )
    parser.add_argument(
        "--zero_root",
        default=os.path.join(_REPO_ROOT, "data", "things_eeg"),
        help="parent dir containing preprocessed_eeg_zero_<band>_fourier",
    )
    parser.add_argument(
        "--bands",
        nargs="*",
        default=BANDS,
        choices=BANDS,
        help="bands to evaluate; pass nothing after --bands to only eval original",
    )
    parser.add_argument("--sub_id", nargs="+", type=int, default=[8])
    parser.add_argument(
        "--image_feature_dir",
        default=os.path.join(_REPO_ROOT, "data", "things_eeg", "image_feature", "RN50"),
    )
    parser.add_argument(
        "--aug_image_feature_dirs",
        nargs="+",
        default=[
            os.path.join(
                _REPO_ROOT,
                "data",
                "things_eeg",
                "image_feature",
                "RN50",
                "GaussianBlur-GaussianNoise-LowResolution-Mosaic",
            )
        ],
    )
    parser.add_argument(
        "--image_test_aug",
        action=argparse.BooleanOptionalAction,
        default=True,
        help="match official eval (--image_test_aug); use --no-image_test_aug to disable",
    )
    parser.add_argument("--img_l2norm", action=argparse.BooleanOptionalAction, default=True)
    parser.add_argument("--eeg_l2norm", action=argparse.BooleanOptionalAction, default=False)
    parser.add_argument("--seed", type=int, default=2025)
    parser.add_argument("--text_feature_dir", default="")
    parser.add_argument("--feature_dim", type=int, default=512)
    parser.add_argument("--selected_channels", nargs="+", default=DEFAULT_CHANNELS)
    parser.add_argument("--time_window", nargs=2, type=int, default=[0, 250])
    parser.add_argument("--batch_size", type=int, default=200)
    parser.add_argument("--device", default="cpu", help="cpu is safer if GPU arch unsupported by PyTorch")
    parser.add_argument(
        "--out_dir",
        default=os.path.join(_REPO_ROOT, "data", "acc_zero-bands_results"),
    )
    args = parser.parse_args()

    set_seed(args.seed)
    print(f"image_test_aug={args.image_test_aug}  img_l2norm={args.img_l2norm}  seed={args.seed}")

    if not os.path.isfile(args.checkpoint_path):
        raise FileNotFoundError(f"Checkpoint not found: {args.checkpoint_path}")
    if not os.path.isdir(args.eeg_ori_dir):
        raise FileNotFoundError(f"Original EEG dir not found: {args.eeg_ori_dir}")

    if args.device.startswith("cuda") and torch.cuda.is_available():
        try:
            # Probe whether current GPU arch is usable with this PyTorch build
            torch.zeros(1, device=args.device)
            device = torch.device(args.device)
        except RuntimeError as e:
            print(f"CUDA not usable ({e}); falling back to CPU.")
            device = torch.device("cpu")
    else:
        device = torch.device("cpu")
    print(f"Device: {device}")
    print(f"Checkpoint: {args.checkpoint_path}")
    os.makedirs(args.out_dir, exist_ok=True)

    rows: list[dict] = []

    print("\n>>> Original EEG")
    acc = evaluate_eeg_dir(args.eeg_ori_dir, args, device)
    print(f"  Top-1={acc['top1']:.2f}%  Top-5={acc['top5']:.2f}%  n={int(acc['n'])}")
    rows.append({"condition": "original", "band": "", **acc})

    for band in args.bands:
        zero_dir = os.path.join(args.zero_root, f"preprocessed_eeg_zero_{band}_fourier")
        print(f"\n>>> Zero band: {band}")
        print(f"  dir: {zero_dir}")
        if not os.path.isdir(zero_dir):
            print("  SKIP: directory missing")
            continue
        sub = args.sub_id[0]
        test_path = os.path.join(zero_dir, f"sub-{sub:02d}", "test.npy")
        if not os.path.isfile(test_path):
            print(f"  SKIP: missing {test_path}")
            continue
        acc = evaluate_eeg_dir(zero_dir, args, device)
        print(f"  Top-1={acc['top1']:.2f}%  Top-5={acc['top5']:.2f}%  "
              f"Δtop1={acc['top1'] - rows[0]['top1']:+.2f}")
        rows.append({"condition": f"zero_{band}", "band": band, **acc})

    # Save CSV
    csv_path = os.path.join(args.out_dir, f"sub-{args.sub_id[0]:02d}_ori_vs_zero_acc.csv")
    with open(csv_path, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(
            f, fieldnames=["condition", "band", "top1", "top5", "n", "delta_top1", "delta_top5"]
        )
        writer.writeheader()
        ori = rows[0]
        for r in rows:
            writer.writerow(
                {
                    "condition": r["condition"],
                    "band": r["band"],
                    "top1": f"{r['top1']:.4f}",
                    "top5": f"{r['top5']:.4f}",
                    "n": int(r["n"]),
                    "delta_top1": f"{r['top1'] - ori['top1']:+.4f}",
                    "delta_top5": f"{r['top5'] - ori['top5']:+.4f}",
                }
            )
    print(f"\nSaved CSV: {csv_path}")

    fig_path = os.path.join(args.out_dir, f"sub-{args.sub_id[0]:02d}_ori_vs_zero_acc.png")
    plot_results(rows, fig_path, args.sub_id[0])

    print("\nDone.")


if __name__ == "__main__":
    main()
